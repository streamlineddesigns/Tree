      - {fileID: 8300000, guid: f1787678a32b2694e84187364337a010, type: 3}
      - {fileID: 8300000, guid: 1e1976cfdac0a0b4faea9bddfc79c179, type: 3}
      - {fileID: 8300000, guid: 1fcff309072aa4f4a88d28a32e601735, type: 3}
      music: {fileID: 8300000, guid: ec418604a8c156345b2bf2927f0a90e8, type: 3}
    - heading: Faltering
      subHeading: Chapter III
      cutScenes:
      - message: Momentary motivation weakens against discouragement
      - message: The cold creeps back in <br> Malice haunts familiar halls
      - message: I stumble under its weight <br> struggling to break free
      - message: "Tucked within my cloak; a gem <br> \u201CYou don\u2019t walk this
          road alone\u201D"
      - message: "I\u2019ve heard this, yet I cannot believe <br> Does anyone understand?"
      levels:
      - levelFile: {fileID: 4900000, guid: e93173e813b618f448b014e98185088d, type: 3}
      - levelFile: {fileID: 4900000, guid: 3685465cc1e66a0449e6b69c6061f68f, type: 3}
