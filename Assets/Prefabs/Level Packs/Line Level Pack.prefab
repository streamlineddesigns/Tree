      - Chapitre 2
      - "\u0413\u043B\u0430\u0432\u0430 2"
      - "Cap\xEDtulo 2"
      - Hoofdstuk 2
      - "\u30C1\u30E3\u30D7\u30BF\u30FC2"
      - Capitolo 2
      - "B\xF6l\xFCm 2"
