MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 684634125}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 172bd2d4ffef67f42b33ee5c4f8da9c8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  ViewName: 16
  tutorialData:
  - messageTranslations:
    - Swipe, aim, & release to Sling Shot
    - Mag-swipe, tumutok, at bitawan para sa Tirador
    levelID: 0
    chapterID: 0
    prefab: {fileID: 4567484295463018693, guid: 78960a21e37731b428f197d77d1d0050, type: 3}
  - messageTranslations:
    - Connect the Colors!
    - Pagdugtungin ang mga Kulay!
    levelID: 1
    chapterID: 0
    prefab: {fileID: 7084687509043369383, guid: 48d7aefeb050e6a4292b9b26d9466cd5, type: 3}
  - messageTranslations:
    - Jump into Connections to Safe Travel
    - Lumundag sa mga Koneksyon para sa Ligtas na Paglalakbay
    levelID: 2
    chapterID: 0
    prefab: {fileID: 4217451847317090821, guid: fd7fb447b2c2595459828cadfedb7b72, type: 3}
  - messageTranslations:
    - Phase through the same color as you!
    - Dumaan sa parehong kulay tulad mo!
    levelID: 3
    chapterID: 0
    prefab: {fileID: 5807188408184330554, guid: 1b1d300f582b9a34a953089d1e252e4c, type: 3}
  - messageTranslations:
    - Swipe in air to Dash
    - Mag-swipe sa hangin para umarangkada!
    levelID: 4
    chapterID: 0
    prefab: {fileID: 2147583252487596410, guid: b5c52a36b50d37c49838c30af9f9eb4f, type: 3}
  - messageTranslations:
    - The more cells you use, the more stars you earn!
    - Kapag mas maraming selula ang ginamit mo, mas maraming bituin ang makukuha
      mo!
    levelID: 6
    chapterID: 0
    prefab: {fileID: 0}
  - messageTranslations:
    - Phase through the same color as you!
    - Dumaan sa parehong kulay tulad mo!
    levelID: 0
    chapterID: 1
    prefab: {fileID: 5807188408184330554, guid: 1b1d300f582b9a34a953089d1e252e4c, type: 3}
  - messageTranslations:
    - Landing alternates your color between white & black
    - Ang paglapag ay nagpapalit ng iyong kulay sa pagitan ng puti at itim
    levelID: 0
    chapterID: 2
    prefab: {fileID: 4217451847317090821, guid: 62ab0d4ed6d933d4fbe395e29844db25, type: 3}
  - messageTranslations:
    - Use the map to zoom in and out
    - Gamitin ang mapa para mag-zoom in at zoom out
    levelID: 2
    chapterID: 2
    prefab: {fileID: 0}
  - messageTranslations:
    - Combine your Jumps & Dash's
    - Pagsamahin ang iyong mga Lundag at Arangkada
    levelID: 4
    chapterID: 2
    prefab: {fileID: 4217451847317090821, guid: e0ff22be5621ee54db722e406dd29e2b, type: 3}
  - messageTranslations:
    - Use the alternating color to your advantage
    - Gamitin ang nagpapalitang kulay para sa iyong kalamangan
    levelID: 6
    chapterID: 2
    prefab: {fileID: 0}
  - messageTranslations:
    - 'Reset buttons remove a color''s connections '
    - Ang mga pindutan ng pag-reset ay nag-aalis ng mga koneksyon ng isang kulay
    levelID: 8
    chapterID: 2
    prefab: {fileID: 0}
  - messageTranslations:
    - Creativity can get you places you wouldn't expect
    - Ang pagiging malikhain ay makapaghahatid sa iyo sa mga lugar na hindi mo inaasahan
    levelID: 10
    chapterID: 2
    prefab: {fileID: 0}
  messageText: {fileID: 1579892747}
  messageShadowText: {fileID: 221252145}
  tutorialsParent: {fileID: 2062295415}
