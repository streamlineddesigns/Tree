  m_Name: 
  m_EditorClassIdentifier: 
  levelChapters:
    chapters:
    - heading: Darkness
      subHeading: Chapter I
      cutScenes:
      - message: Light extinguished, heading blindly down an endless midnight path
      - message: Where is the light? <br> The days fade one into the next
      - message: Loneliness has become my only companion <br> I wander lost in this
          colorless fog
      - message: Is there no path ahead? <br> The darkness is all I see
      - message: It feels as if it will never end <br> I cannot see beyond this night
      levels:
      - levelFile: {fileID: 4900000, guid: a4442b5e00a7fc3419d04a3f959298b7, type: 3}
      - levelFile: {fileID: 4900000, guid: 294114194941d974d80562b66fed6801, type: 3}
      - levelFile: {fileID: 4900000, guid: 12656b50a8d884e44940634a8498ad0b, type: 3}
