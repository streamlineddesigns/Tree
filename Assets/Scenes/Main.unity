MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 266041483}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dd690169db49aa347909a6f48b33a2c3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  levelChapters:
    chapters:
    - heading: Darkness
      subHeading: Chapter I
      cutScenes:
      - message: How do we find our way when all seems lost?
      - message: In the depths of our despair, we often forget that darkness is not
          permanent
      - message: Darkness is a blank canvas waiting for the first brush stroke of
          light
      - message: What if our struggles are not punishments, but opportunities for
          growth?
      - message: Perhaps the darkness is where we learn to create our own light
      levels:
      - levelFile: {fileID: 4900000, guid: a4442b5e00a7fc3419d04a3f959298b7, type: 3}
      - levelFile: {fileID: 4900000, guid: 294114194941d974d80562b66fed6801, type: 3}
      - levelFile: {fileID: 4900000, guid: 12656b50a8d884e44940634a8498ad0b, type: 3}
      - levelFile: {fileID: 4900000, guid: b16eaf69a6484774ea3e2667555da0d1, type: 3}
      - levelFile: {fileID: 4900000, guid: 2808cec5626ffed42a1b72356ec339fa, type: 3}
      - levelFile: {fileID: 4900000, guid: 4d267c8254c161f46bb8c623d89b483b, type: 3}
      - levelFile: {fileID: 4900000, guid: a7531536fa333654fbf1268a654ba1f4, type: 3}
      - levelFile: {fileID: 4900000, guid: 4905f80fb817218438944743648d8245, type: 3}
      - levelFile: {fileID: 4900000, guid: 59335e03b1efbb541abdb45b6a055a09, type: 3}
      - levelFile: {fileID: 4900000, guid: dd8583e533881124eb5aae0cf596a4e4, type: 3}
      - levelFile: {fileID: 4900000, guid: dc0f0e169eb5423449fcea3b98c0fc6b, type: 3}
      - levelFile: {fileID: 4900000, guid: 5ea4885e9a205bf4d91bd47aa23a98cc, type: 3}
      - levelFile: {fileID: 4900000, guid: 6f89c84e11f62a844abda64aa6932589, type: 3}
      - levelFile: {fileID: 4900000, guid: 807ca5766b5e4714d9b97d1034a5005f, type: 3}
      - levelFile: {fileID: 4900000, guid: fc05d882af6112b4d9d400a4bdfe61f6, type: 3}
      narration:
      - {fileID: 8300000, guid: 3d0e0367a99e61d4fa501f21c1ff5c5a, type: 3}
      - {fileID: 8300000, guid: c1f75e46e3d82b04fbddcd619714f7d9, type: 3}
      - {fileID: 8300000, guid: 84b07d35939ff8c4591260d454d43301, type: 3}
      - {fileID: 8300000, guid: 0b8df90105aef1f46b79e913cac22569, type: 3}
      - {fileID: 8300000, guid: 71bf8e94bf91c024b9bff42f64ce9ab7, type: 3}
      music: {fileID: 8300000, guid: 7668c0e37fa0f2048871241a147b6b67, type: 3}
    - heading: Glimmer
      subHeading: Chapter II
      cutScenes:
      - message: Can a single spark of hope change everything?
      - message: Hope, no matter how small, has the power to light up our darkest
          moments
      - message: Hope is the whisper that tells us to hold on for one more day
      - message: What if that tiny glimmer is the universe's way of showing us that
          change is possible?
      - message: Maybe it's not about waiting for the storm to pass, but learning
          to dance in the rain
      levels:
      - levelFile: {fileID: 4900000, guid: 4bd60e8a5059bfb488d1fb6d93269e77, type: 3}
      - levelFile: {fileID: 4900000, guid: d097161bc27bc3d40b816c0aa619b045, type: 3}
      - levelFile: {fileID: 4900000, guid: a85eed6c11b77834a8dbec0eceb9efe8, type: 3}
