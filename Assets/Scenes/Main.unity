      music: {fileID: 8300000, guid: e57c17f7ab219f74f92ac36f81df1ef0, type: 3}
    - heading: Reaching
      subHeading: Chapter IV
      cutScenes:
      - message: A compassionate hand lights the way to communities embrace
      - message: I signal out into the mist <br> A beacon guides me toward
      - message: "A glowing, welcoming hall <br> \u201CCome sit, share your weary
          heart\u201D"
      - message: Within this circle of light <br> I join fellow travelers
      - message: Those who wind the same path <br> Together we travel on
      levels:
      - levelFile: {fileID: 4900000, guid: 4265815932fc993429cf4dfa9b199117, type: 3}
      - levelFile: {fileID: 4900000, guid: 5a3db804bcae04d44b42911726f5c282, type: 3}
